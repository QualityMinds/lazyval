<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>com.qualityminds.lazyval</groupId>
        <artifactId>lazyval-parent</artifactId>
    </parent>

    <groupId>com.qualityminds.lazyval.integration</groupId>
    <artifactId>integration-test-parent</artifactId>
    <name>Integration Test Parent</name>
    <packaging>pom</packaging>

    <properties>
        <!-- test-only modules should never be installed/deployed -->
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <gpg.skip>true</gpg.skip>
    </properties>

    <subprojects>
        <subproject>api-client</subproject>
        <subproject>java/shared</subproject>
        <subproject>java/jee</subproject>
        <subproject>java/quarkus-app</subproject>
        <subproject>java/quarkus-jsonb-app</subproject>
        <subproject>java/spring-app</subproject>
        <subproject>kotlin/shared</subproject>
        <subproject>kotlin/spring-app</subproject>
        <subproject>kotlin/jee</subproject>
        <subproject>kotlin/quarkus-app</subproject>
        <subproject>kotlin/quarkus-jsonb-app</subproject>
    </subprojects>
</project>