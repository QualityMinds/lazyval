import mill.*
import mill.kotlinlib.*
import mill.kotlinlib.ksp.*

object `package` extends KotlinMavenModule with KspModule {

  object Version{
    val lazyval = sys.props.getOrElse("version.lazyval", "0.3.0")
    val mapstruct = "1.6.3"
    val jpa = "3.2.0"
    val jackson = "3.1.0"
  }

  override def kotlinVersion = "2.3.0"
  override def kspVersion = "2.3.4"
  override def kspJvmTarget = "17"
  override def kspModuleMode = KspModuleMode.Ksp2 // could be omitted, as it is the default

  // tag::docu[]
  // tag::excluded[]
  override def repositories: T[Seq[String]] = super.repositories() ++ Seq(
    coursier.Repositories.central.root,
    // the previously installed snapshot is in local maven
    // see docs on Coursier, why m2 is considered dangerous
    coursier.LocalRepositories.Dangerous.maven2Local.root,
  )
  // end::excluded[]

  override def mvnDeps: T[Seq[Dep]] = Seq(
    mvn"org.mapstruct:mapstruct:${Version.mapstruct}"
  )

  override def compileMvnDeps: T[Seq[Dep]] = Seq(
    mvn"com.qualityminds.lazyval:lazyval:${Version.lazyval}",
    mvn"jakarta.persistence:jakarta.persistence-api:${Version.jpa}",
    mvn"org.mapstruct:mapstruct-processor:${Version.mapstruct}",
    mvn"tools.jackson.core:jackson-databind:${Version.jackson}"
  )

  // tag::excluded[]
  // currently not working for Kotlin projects
  //  override def annotationProcessorsMvnDeps = Seq(
  //    mvn"org.mapstruct:mapstruct-processor:${Version.mapstruct}"
  //  )
  // end::excluded[]

  override def kotlinSymbolProcessors: T[Seq[Dep]] = Seq(
    mvn"com.qualityminds.lazyval:lazyval-ksp:${Version.lazyval}"
  )

  def javacOptions = super.javacOptions() ++ Seq(
    // as of Java 25, Annotation Processors must be explicitly enabled
    // alternatively use "-proc:full"
    "-processor", "org.mapstruct.ap.MappingProcessor",
    "-Amapstruct.unmappedTargetPolicy=ERROR",
  )

  override def kspProcessorOptions: T[Map[String, String]] = Map(
    "lazyval.generators.basePackage" -> "test",
    "lazyval.mapstruct.package" -> "test.custom"
  )
  // end::docu[]
}
