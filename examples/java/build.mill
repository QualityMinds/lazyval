//| mill-version: 1.1.0
//| mill-jvm-version: zulu:21
import mill.*
import mill.javalib.*

object `package` extends JavaModule with MavenModule{
  
  object Version{
    val lazyval = "0.1.0-SNAPSHOT"
    val mapstruct = "1.6.3"
    val jpa = "3.2.0"
  }

  // tag::docu[]
  // tag::excluded[]
  override def repositories: T[Seq[String]] = super.repositories() ++ Seq(
    coursier.Repositories.central.root,
    // the previously installed snapshot is in local maven
    // see docs on Coursier, why m2 is considered dangerous
    coursier.LocalRepositories.Dangerous.maven2Local.root,
  )
  // end::excluded[]

  override def mvnDeps: T[Seq[Dep]] = Seq(
    mvn"org.mapstruct:mapstruct:${Version.mapstruct}",
  )

  override def compileMvnDeps: T[Seq[Dep]] = Seq(
    mvn"de.qualityminds.lazyval:lazyval:${Version.lazyval}",
    mvn"de.qualityminds.lazyval:lazyval-processor:${Version.lazyval}",
    mvn"jakarta.persistence:jakarta.persistence-api:${Version.jpa}",
    mvn"org.mapstruct:mapstruct-processor:${Version.mapstruct}"
  )

  def javacOptions = super.javacOptions() ++ Seq(
    // as of Java 25, Annotation Processors must be explicitly enabled
    // alternatively use "-proc:full"
    "-processor", "de.qualityminds.lazyval.processor.LazyvalProcessor,org.mapstruct.ap.MappingProcessor",
    "-Amapstruct.unmappedTargetPolicy=ERROR",
    "-Alazyval.jpa.generatedPackage=test.boundary.persistence",
    "-Alazyval.mapstruct.generatedPackage=test",
  )
  // end::docu[]
}
